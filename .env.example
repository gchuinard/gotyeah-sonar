# Variables d'environnement de Sonar.
# Copie ce fichier en `.env` (NON committé) et renseigne tes valeurs :
#   cp .env.example .env
# Docker Compose lit automatiquement le `.env` du même dossier.

# --- Auth (P0) — connexion par lien magique ---
# URL PUBLIQUE de Sonar : sert à construire les liens magiques envoyés par email.
# IMPORTANT derrière un proxy : sans ça, les liens pointeraient vers l'URL interne.
SONAR_BASE_URL=https://sonar.gautierchuinard.com
# Inscription ouverte (true) ou sur invitation seulement (false). Défaut: false.
SONAR_OPEN_REGISTRATION=false
# Admin bootstrappé (indépendant de l'email) : un lien de login one-time est
# imprimé dans les logs au démarrage -> `docker logs sonar`.
SONAR_ADMIN_EMAIL=gautierchuinard@gmail.com
# Par défaut, l'admin scanne N'IMPORTE QUEL domaine sans vérification DNS (commodité).
# Mets `false` pour soumettre l'admin au MÊME gate que les autres (vérifier ses domaines
# par DNS avant de scanner). N'affecte que l'admin ; les non-admins restent toujours gatés.
#SONAR_ADMIN_SCAN_ANY=false

# --- Emails (Brevo) — envoi des liens magiques ---
# Tant que BREVO_API_KEY est vide, le lien est LOGGÉ au lieu d'être envoyé
# (récupère-le dans `docker logs sonar`). Renseigne ta clé Brevo pour activer l'envoi.
BREVO_API_KEY=
SONAR_MAIL_FROM=sonar@gautierchuinard.com
SONAR_MAIL_FROM_NAME=Sonar

# Réglages auth optionnels (défauts raisonnables, décommente au besoin)
#SONAR_MAGIC_TTL_MIN=15     # durée de vie du lien magique (minutes)
#SONAR_SESSION_DAYS=30      # durée de la session (jours)
#SONAR_RATE_EMAIL=5         # max de demandes de lien par email / fenêtre
#SONAR_RATE_IP=20           # max de demandes de lien par IP / fenêtre
#SONAR_COOKIE_SECURE=true   # mets false UNIQUEMENT pour tester en local sur http://

# --- OWASP ZAP (Phase 3, optionnel) ---
# Laisse ZAP_API_URL vide => le check ZAP reste discret ("ZAP non configuré").
# Pour ACTIVER ZAP :
#   1) génère une clé :            openssl rand -hex 24
#   2) renseigne les 2 lignes ci-dessous (ZAP_API_KEY = la clé générée)
#   3) démarre le démon ZAP :      docker compose --profile zap up -d
ZAP_API_URL=
ZAP_API_KEY=

# Options ZAP (décommente au besoin)
#ZAP_ACTIVE=on          # AJOUTE un scan ACTIF (intrusif) — défaut: passif seulement
#ZAP_SPIDER_MAX=10      # nb max de pages explorées par le spider
#ZAP_TIMEOUT=240        # délai global du scan ZAP (secondes)

# --- nuclei (Phase 3) — déjà dans l'image et ACTIF par défaut, rien à faire ---
#NUCLEI_SEVERITY=medium,high,critical
#NUCLEI_TIMEOUT=240

# --- Scan de ports/services (réseau) — ACTIF par défaut, borné et lecture seule ---
# Derrière un CDN (Cloudflare), l'IP résolue est l'edge du tiers : le scan est alors
# ignoré (finding INFO « derrière Cloudflare »). Pour viser TON origine, renseigne son IP :
#SONAR_ORIGIN_IP=203.0.113.10
# Réglages (décommente au besoin) :
#SONAR_PORTS_TIMEOUT=2        # délai par port (secondes)
#SONAR_PORTS_CONCURRENCY=12   # sondes simultanées
#SONAR_PORTS_LIST=6379,3306,27017,9200   # restreint la liste de ports scannés

# --- MCP DISTANT (claude.ai web) — surface OAuth PUBLIQUE, opt-in ---
# Expose un endpoint MCP distant (/mcp) + les endpoints OAuth pour que claude.ai web
# puisse lire tes rapports. DÉSACTIVÉ par défaut (surface publique authentifiée).
# Requiert SONAR_BASE_URL en HTTPS (OAuth exige un issuer absolu). Mets "on" pour activer.
# NB : différent du MCP stdio LOCAL (README §MCP), qui passe par un PAT et ne sort pas
# de ta machine. Ici, c'est le serveur Sonar qui expose l'accès distant.
#SONAR_MCP_REMOTE=on
# IdP OIDC en amont (Pocket ID) — REQUIS quand SONAR_MCP_REMOTE=on : l'auth de /mcp est
# déléguée à l'IdP via l'OIDCProxy de FastMCP. Crée un client confidentiel dans l'IdP
# (callback = <SONAR_BASE_URL>/auth/callback) et renseigne ses identifiants ci-dessous.
#SONAR_OIDC_CONFIG_URL=https://idp.gautierchuinard.com/.well-known/openid-configuration
#SONAR_OIDC_CLIENT_ID=
#SONAR_OIDC_CLIENT_SECRET=
# L'outil run_scan (MCP) lance un scan asynchrone : il attend ce délai (secondes) avant
# de rendre la main. Au-delà, il renvoie l'scan_id et le rapport se récupère via get_report.
# Garde-le sous les timeouts proxy (~60-100 s). Défaut : 25.
#SONAR_MCP_SCAN_WAIT=25
# Anti-abus de run_scan (action publique) : nb max de scans par compte et fenêtre (min).
# Défauts : 10 scans / 15 min. Décommente pour ajuster.
#SONAR_SCAN_RATE=10
#SONAR_SCAN_RATE_WINDOW_MIN=15

# --- Coupe-circuits (laisse COMMENTÉ pour garder les checks actifs) ---
# Ces variables ne servent QU'À DÉSACTIVER : seule la valeur "off" est reconnue.
# Les mettre à "on" ne fait rien. Décommente uniquement pour éteindre un moteur.
#SONAR_NUCLEI=off       # éteint le check nuclei
#SONAR_ZAP=off          # éteint le check ZAP (même si ZAP_API_URL est défini)
#SONAR_PORTS=off        # éteint le scan de ports/services
